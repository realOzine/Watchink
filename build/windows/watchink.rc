/*
 * Resource script for the Windows executables (Watchink.exe, watchink.com).
 * scripts/build-windows.sh substitutes the __NAME__ placeholders, compiles
 * the result with windres into cmd/watchink/rsrc_windows_amd64.syso, and the
 * Go linker picks that file up. Keep this file ASCII and free of #include so
 * that windres needs nothing but a C preprocessor.
 *
 *   __FILE_VERSION_COMMAS__  four numbers, e.g. 0,1,0,0
 *   __VERSION__              full version, e.g. 0.1.0-dev
 *   __BUILD_ID__             <short commit>-<UTC date>
 *
 * Icon id 3 is the id Wails loads the window icon from (winc.AppIconID); as
 * the only icon group it is also what Explorer shows. 24 is RT_MANIFEST.
 */
3 ICON "Watchink.ico"
1 24 "watchink.gen.manifest"

1 VERSIONINFO
FILEVERSION __FILE_VERSION_COMMAS__
PRODUCTVERSION __FILE_VERSION_COMMAS__
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS 0x40004L
FILETYPE 0x1L
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Watchink"
            VALUE "FileDescription", "Watchink"
            VALUE "FileVersion", "__VERSION__"
            VALUE "InternalName", "watchink"
            VALUE "OriginalFilename", "Watchink.exe"
            VALUE "ProductName", "Watchink"
            VALUE "ProductVersion", "__VERSION__ (__BUILD_ID__)"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
